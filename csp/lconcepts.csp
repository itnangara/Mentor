    <!-- Iterating through Dynamic arrays -->
    
    Set result = {"ID":"1","Name":"Isaac N","Email":"isaac@gmail.com","Gender":"Male","BooksValue":[{"Name":"How to be one with oneself"}, {"Name":"How to make money"}]}
    <!-- BooksValue is of type %Libray.DynamicArray -->
    <!-- To get first book use index position eg 0 in this case as the below: -->
    Write result.BooksValue.%Get(0).Name

    <!-- To get all books use for all positions, use the below: -->
    Set booksArray = result.BooksValue

    Set iterator = booksArray.%GetIterator()
    While iterator.%GetNext(.key, .obj){
        Write "key: ", key, " key end" // key = 0,1,2.... its the index position
        Write "obj: ", obj.Name, " obj end" // obj = object, use it to access the obj properties
    }
