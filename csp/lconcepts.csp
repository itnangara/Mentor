<!-- the following creates:
                        arr = Dynamic Array (#####@%Library.DynamicArray)
                        obj = Dynamic Object (#####@%Library.DynamicObject)
Both can not work in JS functions and most manipulations outside CLS methods so:
                        convert them to %ToJSON()
                            1 - You can convert 1 object
                            2 - You can convert an array with multiple objects
-->
<script language="cache" runat="Server">
    set obj = {}
    set obj.ID = Authors.ID
    set obj.Name = Authors.Name
    // set obj.Email = Authors.Email
    // set obj.Gender = Authors.Gender

    set arr = []
    Do arr.%Push(obj)

    set resJSON = arr.%ToJSON()
    set objJSON = obj.%ToJSON()
</script>
<p>res: #(arr)#</p> <!-- this shows a dynamic array -->

