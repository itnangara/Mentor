<script language="cache" runat="Server">
    #; querying data and returning a resultset, use loops to iterate
    Set rs = ##class(%SQL.Statement).%ExecDirect(,"SELECT * FROM Mentor.Book WHERE ID='5'")
    While rs.%Next() {
        Write !, "ID: ", rs.ID, !!
        Write "Name: ", rs.Name, !
    }
    
    #; Checking for a specific ID using Name then storing returned ID into new variable ID
    Set booksValue = "New Paradisessssssssssssssssssss"
    &SQL(
        Declare SC Cursor 
        For SELECT ID INTO :ID
        FROM Mentor.Book
        WHERE Name=:booksValue
    )
    &SQL(Open SC)

    Quit:(SQLCODE'=0)
    IF SQLCODE<0 { WRITE "SQLCODE error ",SQLCODE," ",%msg  QUIT }
    ELSEIF SQLCODE=100 {WRITE "Author not found"  QUIT}
</script>
