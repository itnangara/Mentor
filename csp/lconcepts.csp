<script language="cache" runat="server">
    set x = 10
</script>
<script language="cache" runat="server">
    set y = 20
    set authorID = "2"
</script>

<p>X + Y is #(x + y)#</p> // making a calulation with variables in the script -->
<p>Y is #(y)#</p> // calling an integer variable set in the script -->
<p>Author ID is #(authorID)#</p> // calling a string variable set in the script -->

// Sending query parameters to a cls pre-defined class above: use p1, p2...not custom words -->
<csp:query name="Author" classname="Mentor.Author" queryname="GetAuthor" p1=#(authorID)#>
    <p>X + Y is #(x + y)#</p>
    <csp:while condition="Author.Next()">    
        <p>Name: #(Author.Name)#</p>
        <p>Author ID: #(Author.ID)#</p>
    </csp:while>
</csp:query>
<p>.....................................................................</p>
<csp:query name="Author" classname="Mentor.Author" queryname="GetAuthor">
    <csp:param name="ID" value="2" />
    
    <p>X + Y is #(x + y)#</p>
    <csp:while condition="Author.Next()">    
        <p>Name: #(Author.Name)#</p>
        <p>Author ID: #(Author.ID)#</p>
    </csp:while>
</csp:query>
<p>.....................................................................</p>
<csp:query name="Authors" classname="Mentor.Author" queryname="GetAllAuthors">
<csp:while condition="Authors.Next()">
    <p>#(Authors.ID)#</p>
    <p>#(Authors.Name)#</p>
</csp:while>
</csp:query>
<p>.....................................................................</p>
<csp:query name="Books" classname="Mentor.Book" queryname="GetAllBooks">
