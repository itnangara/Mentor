<!-- Using dictionaries in Object Script -->
<!-- Initialize the associative array -->
Set existingBookTitles = []

// Populate the associative array with keys
Set existingBookTitles("Book1") = 1
Set existingBookTitles("Book2") = 1
Set existingBookTitles("Book3") = 1

// Iterate and display the keys
Set key = ""
For {
    Set key = $Order(existingBookTitles(key))
    If key = "" Quit  // Exit the loop when there are no more keys
    Write "Key: ", key, !
}
