<!-- To return objects, always return converted JSON, for simple objects not the resultset
ClassMethod AddShow() As %String
{
    Set sc = 1000
    Set obj = ##class(Mentor.Author).%New()
    set obj.Name = "Isaac"
    
    // Construct a simple object with relevant data
    Set result = {}
    Set result.Name = obj.Name
    Set result.Status = "Success"
    
    // Convert the object to a JSON string and return it
    Quit result.%ToJSON()
}-->
