<script language="javascript">
    function submitData() {
        // setting form values in js function, the value is from a cls method
        document.getElementById('name').value = #server(Mentor.Author.AddShow2(200))#
        document.getElementById('email').value = #server(Mentor.Author.AddShow2("example email"))#
        document.getElementById('gender').value = #server(Mentor.Author.AddShow2("example gender"))#

        // setting local values by values from the form then sending those values to a cls method
        // the cls method then saves to the DB 
        let name= document.getElementById('name').value
        let res = #server(Mentor.Author.AddShow(name))# // you can email, gender etc
    }
</script>
