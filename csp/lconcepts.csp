<!-- following method is called in the page, and receives an argument also -->
<script language="Cache" method="MakeList" arguments="count:%Integer" returntype="%String">
    Write "<ol>",!
    New i
    For i = 1:1:count {
        Write "<li> Item",i,!
    }
    Write "</ol>",!
    Quit ""
</script>

<!-- Display the generated list -->
<div>
    <h3>Generated List:</h3>
    #(..MakeList(5))#
    <!-- #(server(..serverTest("33")))# -->
</div>
