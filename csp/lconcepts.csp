    <!-- With a bridger, since it contains Author column and Book column -->
    Set rs = ##class(%SQL.Statement).%ExecDirect(,"SELECT * FROM Mentor.BookAuthor WHERE Author = '1'")
    <!-- rs contains rs.Author and rs.Book -->
    <!-- Result sets above returns ID, actual Object, you cannot do .Prop (rs.Author.Name) -->
    <!-- Instead, use returned ref and open actual object using openID (openId(res.Author)) -->
    
    <!-- Check the below Example -->
    Set ID = "1"
    Set author = ##Class(Mentor.Author).%OpenId(ID)

    If (author '= "") {
        Set result = {}
        set result.ID = ID // do not do author.ID because ID is not a class property of Author
        set result.Name = author.Name
        set result.Email = author.Email
        set result.Gender = author.Gender

        Set author2 = ##Class(Mentor.BookAuthor).%OpenId(1) 
        Set rs = ##class(%SQL.Statement).%ExecDirect(,"SELECT * FROM Mentor.BookAuthor WHERE Author = '1'")
        While rs.%Next() {
            Write !, " ...The Book Ref: ", rs.Book, !
            Write !, " ...The Author Ref: ", rs.Author, !
            Write !, " ...The Author2: ", author2.Author, !
        }
    }

    <!-- Notes -->
    <!-- End of Notes -->

