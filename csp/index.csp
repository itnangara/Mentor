<script language="cache" method="GetBooksForAuthor" arguments="ID:%String" returntype="%Status">
    Set author = ##class(Mentor.Author).%OpenId(ID)
    Set authorBookList = author.Bridge
    Set books = []
    Set checkboxSize = authorBookList.Count()
    For i=1:1:authorBookList.Count() {
        Set bookAuthor = authorBookList.GetAt(i)
        Set obj = {}
        Set obj.ID = bookAuthor.Book.%Id()
        Set obj.Name = bookAuthor.Book.Name
        Do books.%Push(obj)
    }

    return books.%ToJSON()
</script>

<script language="cache" method="GetAllBooks" returntype="%String">
    while (Books.Next()) {
        Write "<input id='checkbox_"_Books.ID_"' type='checkbox' class='checkbox-item' name='selectedBooks' value='"_Books.Name_"'>"_Books.Name_"<br>"
    }
    Return ""
</script>


