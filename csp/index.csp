    <script language=cache method=ColumnSelect arguments="Name:%String" returntype="%String" procedureblock>
	Set Result = "<select name=" _ Name _ ">"

	;Values are the actual column names, displays what to display in the column header (initially equal)
	Set Values=$ListBuild(
		$ListBuild("Act_Id", "Act_Id"),
		$ListBuild("ApplicationId", "ApplicatieId"),
		$ListBuild("PatientId", "BSN"),
		$ListBuild("Custodian_URA", "URA"),
		$ListBuild("Custodian_UZI", "UZI beheersverantwoordelijke"),
		$ListBuild("Owner_UZI", "UZI inhoudsverantwoordelijke")
	)

    
	Set Result=Result_"<option value="""">&nbsp;</option>"

	For i = 1 : 1 : $ListLength(Values) {
		Set Data = $ListGet(Values,i), Value = $ListGet(Data,1), Display = $ListGet(Data,2)
		Set Result = Result _ "<option value=""" _ $ZConvert(Value,"O","HTML") _ """"
		If %request.Get(Name) = Value Set Result = Result _ " selected"
		Set Result = Result _ ">" _ $ZConvert(Display,"O","HTML") _ "</option>"
	}

	Set Result = Result _ "</select>"
	
	Quit Result
</script>
    <!-- ------------------------------------------------------------ -->
    <fieldset class="Round">
        <legend class="Legend">Test</legend>
        <div>
            <select id="myselectd" multiple size="8" onchange="myselectf();">

                <script language="cache" runat="server">
                    &SQL(DECLARE dcCur CURSOR FOR
                        SELECT Name, Email INTO :Name, :Email
                        FROM Mentor.Author
                        ORDER BY Name
                        )
                    &SQL(OPEN dcCur)
                    For  {
                        &SQL(FETCH dcCur)
                        If SQLCODE Quit
                        Write "<option value="""_Name_""""
                        //If Config.myselect[Name Write " selected "
                        Write ">"_Name_"&nbsp;"_Email_"</option>",!
                    }
                    &SQL(CLOSE dcCur)
                </script>
            </select>
            <input type="hidden" name="myselect" id="myselect" cspbind="myselect">
        </div>
    </fieldset>
    <!-- ------------------------------------------------------------ -->

    <csp:object name=Obj classname="Mentor.Author" objid="#(%request.Get("OBJID"))#" cspjs=All>

    <h>MySelectOptions</th>
    <select name=Name cspbind=Name>#(..meth(Obj.Name))#</select>
    <!-- ------------------------------------------------------------ -->

    <!-- Modal -->
    <div class="modal" id="modal" tabindex="-1">
        <div class="modal-dialog" role="document">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="addBookHeader">Add Author</h5>
              <h5 class="modal-title" id="editBookHeader">Edit Author</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <form>
                  <div class="form-group">
                    <label for="id" class="col-form-label" hidden></label>
                    <input type="text" id="id" hidden>
                    <label for="name" class="col-form-label">Name:</label>
                    <input type="text" class="form-control" id="name" placeholder="">
                    <label for="email" class="col-form-label">Email:</label>
                    <input type="text" class="form-control" id="email" placeholder="">
                    <label for="gender" class="col-form-label">Gender:</label>
                    <input type="text" class="form-control" id="gender" placeholder="">
                    <br>

                    <csp:query name="Books" classname="Mentor.Book" queryname="GetAllBooks"></csp:query>
                    
                    Select Books
                    <div class="form-check">
                        <label class="form-check-label" for="flexCheckChecked">
                            #(..GetAllBooks())#
                        </label>
                    </div>
                  </div>
                </form>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
              <button id="newBtn" type="button" class="btn btn-primary" onclick="saveNewAuthorJs()">Save Author</button>
              <button id="editBtn" type="button" class="btn btn-primary" onclick="updateAuthorJs()">Save Changes</button>
            </div>
          </div>
        </div>
    </div>


    <h1 class="header">List of Authors</h1>
    <button class="btn btn-primary cst-btn" onclick="addAuthorJs()">Add Author</button>
    <a href="/mentor/books.csp" class="cst-btn">Books Link</a>
    <csp:include page="spinner.csp"/>
    <div id="cst-tab">
    <table class="table table-striped">
        <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Name</th>
            <th scope="col">Email</th>
            <th scope="col">Gender</th>
            <th scope="col">Action</th>
        </tr>
        </thead>
        <tbody>
            <csp:query name="Authors" classname="Mentor.Author" queryname="GetAllAuthors">
                <csp:while condition="Authors.Next()">
                    <tr>
                    <td>#(Authors.ID)#</td>
                    <td>#(Authors.Name)#</td>
                    <td>#(Authors.Email)#</td>
                    <td>#(Authors.Gender)#</td>
                    <td>
                        <button class="btn btn-primary cst-btn" onclick="editAuthorJs(#(Authors.ID)#)">Edit</button>
                        <button class="btn btn-primary cst-btn" onclick="deleteAuthorJs(#(Authors.ID)#)">Delete</button>
                    </td>
                </tr>
                </csp:while>
            </csp:query>
        </tbody>
    </table>

    </div> 

    <script language=cache method=meth arguments="CurrentValue:%String" returntype="%String" procedureblock>
        /// Creates options for a GebruikersInteractie dropdown;
        
        Set Result="<option>&nbsp;</option>"_$$$EOL
        ;Set Result=Result_"<option value='*'>*</option>"_$$$EOL
        Set rs=##class(%ResultSet).%New()
        Set sc = rs.Prepare("SELECT distinct %EXACT(Name) as gi FROM Mentor.Author ORDER BY Name")
        Set sc=rs.Execute()
        While rs.Next() {
            Set Name=..EscapeHTML(rs.Get("gi"))
            Set Result=Result_"<option value="""_Name_""""
            If Name=CurrentValue Set Result=Result_" selected"
            Set Result=Result_">"_Name_"</option>"_$$$EOL
        }
        Quit Result
    </script>

    <!-- Scripts -->
	<script language="javascript">
        function idCheck() {
            if (document.getElementById('id').value) {
                document.getElementById('addBookHeader').style.display = 'none'
                document.getElementById('editBookHeader').style.display = 'block'
                document.getElementById('newBtn').style.display = 'none'
                document.getElementById('editBtn').style.display = 'block'
            } else {
                document.getElementById('addBookHeader').style.display = 'block'
                document.getElementById('editBookHeader').style.display = 'none'
                document.getElementById('newBtn').style.display = 'block'
                document.getElementById('editBtn').style.display = 'none'
            }
        }

        function addAuthorJs() {
            document.getElementById('id').value = ""
            document.getElementById('name').value = ""
            document.getElementById('email').value = ""
            document.getElementById('gender').value = ""
            
            InitializeCheckboxes();
            idCheck();
            $('#modal').modal('show');
        }

        function saveNewAuthorJs() {
            checkedValues = getCheckboxes();
            let obj = {
                Name: document.getElementById('name').value,
                Email: document.getElementById('email').value,
                Gender: document.getElementById('gender').value,
                BooksValue: checkedValues
            }

            let jsonString = JSON.stringify(obj)
            console.log('res: ', jsonString);
            let res = #server(Mentor.Author.AddAuthor(jsonString))#
            //console.log('res: ', res);
            location.reload(); // Refresh the current page
        }

        function InitializeCheckboxes() {
            const checkboxes = document.querySelectorAll('.checkbox-item');
            checkboxes.forEach((checkbox) => {
                checkbox.checked = false;
            });
        }

        function editAuthorJs(authorID){
            InitializeCheckboxes();
            let resString = #server(Mentor.Author.GetAuthorDetails(authorID))# // Author details
            let resObject = JSON.parse(resString)
            let res = #server(..GetBooksForAuthor(authorID))# // books that belong to Author
            let booksForAuthor = JSON.parse(res)
            
            document.getElementById('id').value = resObject.ID
            document.getElementById('name').value = resObject.Name
            document.getElementById('email').value = resObject.Email
            document.getElementById('gender').value = resObject.Gender

            for (let i=0; i<booksForAuthor.length; i++) {
                let bookId = booksForAuthor[i].ID
                const checkbox = document.getElementById(`checkbox_${bookId}`); // .value
                if (checkbox) {
                    checkbox.checked = true;
                }
            }
            idCheck();
            $('#modal').modal('show')
        }

        function getCheckboxes() {
            checkboxes = document.querySelectorAll('.checkbox-item');
            const checkedValues = [];
            checkboxes.forEach(checkbox => {
                if (checkbox.checked) {
                    let id = checkbox.id.split('_')[1]; 
                    let value = checkbox.value;
                    checkedValues.push({'ID':id, 'Name': value})
                }
            });
            return checkedValues
        }

        function updateAuthorJs() {
            checkedValues = getCheckboxes();

            let obj = {
                ID: document.getElementById('id').value,
                Name: document.getElementById('name').value,
                Email: document.getElementById('email').value,
                Gender: document.getElementById('gender').value,
                BooksValue: checkedValues
            }

            let jsonString = JSON.stringify(obj)
            let res = #server(Mentor.Author.EditAuthor(jsonString))#
            // console.log('updateAuthorJs res: ', res);
            location.reload(); // Refresh the current page
        }

        function deleteAuthorJs(authorID) {
            if (confirm("Are you sure you want to delete this book?")) {
                #server(Mentor.Author.DeleteAuthor(authorID))#
                location.reload(); // Refresh the current page
            }
        }

		function openEditModal(author) {
            console.log('author: ', author)
            // Show the edit modal
            $('#modal').modal('show');
		}
	</script>

