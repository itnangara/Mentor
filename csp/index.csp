    <h>MySelectOptions</th>
    <select name=Name cspbind=Name>#(..ColumnSelect2("Email"))#</select>
    
    <script language="javascript">
        // JavaScript implementation
        // Driver code
        let arr = ["GeeksforGeeks", "Quiz", "Practice", "Gblogs", "Coding"];
        let arr = ["Banana", "Juice", "Apple", "Maheu", "Sadza","Drink", "Pap"];
        let arr = ",Banana,Juice,Apple, Maheu, Sadza, Drink, Pap"
        function sortStrings(arr) {
            let temp;

            // Sorting strings using bubble sort
            for (let j = 0; j < arr.length - 1; j++) {
                for (let i = j + 1; i < arr.length; i++) {
                    if (arr[j].localeCompare(arr[i]) > 0) {
                        temp = arr[j];
                        arr[j] = arr[i];
                        arr[i] = temp;
                    }
                }
            }
        }

        sortStrings(arr);
        console.log("Strings in sorted order are : ");
        for (let i = 0; i < arr.length; i++) {
            console.log(`String ${i + 1} is ${arr[i]}`);
        }

        // Function to be called on page load
        function onPageLoad() {
            sortStrings(arr);
            console.log("Strings in sorted order are : ");
            for (let i = 0; i < arr.length; i++) {
                console.log(`String ${i + 1} is ${arr[i]}`);
            }
        }

        // Call onPageLoad when the window has finished loading
        window.onload = onPageLoad;
    </script>

    <script language=cache method=ColumnSelect2 arguments="Name:%String" returntype="%String" procedureblock>
        Set Result = "<option value="""">&nbsp;</option>" _ $$$EOL
        //Set ClassName = "Mentor.Author"
        //Set PropertyName = Name
        //Set pd = ##class(%Dictionary.PropertyDefinition).%OpenId(ClassName_"||"_PropertyName)
        //If pd = "" Quit Result
        //Set ValueList = pd.Parameters.GetAt("VALUELIST")
        //Set ValueList = ,Opengesteld,Geblokkeerd,Afgesloten

        Set ValueList = $ListBuild("Orange", "Apple", "Juice")

        Set DisplayList = $ListBuild("Orange", "Apple", "Juice")
        write DisplayList

        write "test"
        Set DisplayList = ["Orange", "Apple", "Juice"]
        write "test"
        write DisplayList



        //If ValueList = "" Quit
        //Set DisplayList = pd.Parameters.GetAt("DISPLAYLIST")
        //If DisplayList = "" Set DisplayList = ValueList
        //If pd.Required Set Result = ""
        Set ValueSep = $Extract(ValueList), DisplaySep = $Extract(DisplayList)




        Set CurrentValue = ""
        For i=2:1:$Length(ValueList,ValueSep) {
            Set Value = $Piece(ValueList, ValueSep, i)
            Set Display = $Piece(DisplayList, DisplaySep, i)
            ;CSPBind does a display-to-logical conversion on save, so we need the display value here.
            Set Result = Result_"<option value=""" _ ..EscapeHTML(Display)_""""
            If Value = CurrentValue Set Result = Result_" selected"
            Set Result = Result _ ">" _ ..EscapeHTML(Display) _ "</option>" _ $$$EOL
        }
        write Result

        //return Result
        return 1
    
    </script>
    <script language=cache method=doubleTest arguments="Name:%String" returntype=%Status procedureblock>
        Set Result = "<select name=" _ Name _ ">"

        ;Values are the actual column names, displays what to display in the column header (initially equal)
        Set Values=$ListBuild(
            $ListBuild("1st", "first"),
            $ListBuild("3rd", "third"),
            $ListBuild("2nd", "second"),
            $ListBuild("4th", "forth"),
            $ListBuild("8th", "eigth"),
            $ListBuild("9th", "nineth"),
            $ListBuild("11th", "eleventh"),
        )
        
        Set Result=Result_"<option value="""">&nbsp;</option>"

        For i = 1 : 1 : $ListLength(Values) {
            Set Data = $ListGet(Values,i), Value = $ListGet(Data,1), Display = $ListGet(Data,2)
            Set Result = Result _ "<option value=""" _ $ZConvert(Value,"O","HTML") _ """"
            If %request.Get(Name) = Value Set Result = Result _ " selected"
            Set Result = Result _ ">" _ $ZConvert(Display,"O","HTML") _ "</option>"
        }

        Set Result = Result _ "</select>"
        

        Quit Result
    </script>
